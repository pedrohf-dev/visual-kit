{
  "name": "obsidian-visual-kit",
  "version": "0.9.1",
  "author": "pedrof",
  "private": true,
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "test:browser": "node tests/browser-html-notes.mjs",
    "assets:readme": "node scripts/generate-readme-overview.cjs",
